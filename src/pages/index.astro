---
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";

const items = (await getCollection("journal", (e) => !e.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const month = (d: Date) => d.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });

const youtubeId = (url: string) =>
  url.match(/(?:youtu\.be\/|v=|shorts\/|embed\/)([\w-]{11})/)?.[1];

const prepared = await Promise.all(
  items.map(async (e) => ({
    id: e.id,
    data: e.data,
    label: [month(e.data.date), e.data.caption].filter(Boolean).join(" · "),
    large: e.data.photo ? (await getImage({ src: e.data.photo, width: 2000 })).src : undefined,
    poster: e.data.photo && e.data.video ? (await getImage({ src: e.data.photo, width: 1000 })).src : undefined,
    yt: e.data.youtube ? youtubeId(e.data.youtube) : undefined,
  })),
);
---
<Base title="Albert Le" description="Photos and videos by Albert Le." theme="journal">
  <div class="j-wrap">
    <header class="j-head">
      <h1 class="j-name">Albert Le</h1>
      <a class="j-btn" href="/portfolio/">Portfolio &rarr;</a>
    </header>

    <main class="j-grid">
      {prepared.map((e, i) => (
        <figure class="j-item">
          {e.data.video ? (
            <video src={e.data.video} poster={e.poster} controls playsinline preload="metadata"></video>
          ) : e.yt ? (
            <div class="j-embed">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${e.yt}`}
                title={e.label}
                loading="lazy"
                allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          ) : e.data.photo ? (
            <button class="j-photo" type="button" data-large={e.large} aria-label={`Enlarge: ${e.label}`}>
              <Image
                src={e.data.photo}
                alt={e.label}
                widths={[400, 800, 1200]}
                sizes="(min-width: 1120px) 355px, (min-width: 640px) 50vw, 100vw"
                loading={i < 6 ? "eager" : "lazy"}
              />
            </button>
          ) : null}
          {e.label && <figcaption>{e.label}</figcaption>}
        </figure>
      ))}
    </main>
  </div>

  <dialog class="lightbox" id="lightbox" aria-label="Photo">
    <img alt="" />
  </dialog>

  <script>
    const dialog = document.getElementById("lightbox") as HTMLDialogElement;
    const big = dialog.querySelector("img")!;
    document.querySelectorAll<HTMLButtonElement>(".j-photo").forEach((btn) => {
      btn.addEventListener("click", () => {
        big.src = btn.dataset.large ?? "";
        big.alt = btn.querySelector("img")?.alt ?? "";
        dialog.showModal();
      });
    });
    dialog.addEventListener("click", () => dialog.close());
  </script>
</Base>
