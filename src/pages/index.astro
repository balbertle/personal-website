---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";

const entries = (await getCollection("journal", (e) => !e.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---
<Base title="Albert Le">
  <div class="container">
    <header class="site-header">
      <h1>Albert Le</h1>
      <nav><a href="/portfolio/">portfolio</a></nav>
    </header>

    <main class="grid">
      {entries.map((e, i) => (
        <a class="card" href={`/journal/${e.id}/`}>
          <Image
            src={e.data.photo}
            alt={e.data.caption ?? e.data.title}
            widths={[400, 800, 1200]}
            sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
            loading={i < 3 ? "eager" : "lazy"}
          />
          <p class="card-title">{e.data.title}</p>
        </a>
      ))}
    </main>
  </div>
</Base>
