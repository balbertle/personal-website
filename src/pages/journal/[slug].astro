---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("journal", (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const alt = entry.data.caption ?? entry.data.title;
---
<Base title={entry.data.title} description={entry.data.caption}>
  <div class="container entry" style="padding-top: 1.25rem">
    <div class="detail-header">
      <h1>{entry.data.title}</h1>
      <a class="back" href="/">&larr; back</a>
    </div>

    <div class="entry-body">
      <button class="entry-photo" type="button" aria-label="Enlarge photo" data-open-lightbox>
        <Image src={entry.data.photo} alt={alt} widths={[600, 1000, 1400]} sizes="(min-width: 768px) 40vw, 100vw" loading="eager" />
      </button>
      <div class="entry-text">
        {entry.data.caption && <h2>{entry.data.caption}</h2>}
        <div class="prose"><Content /></div>
      </div>
    </div>
  </div>

  <dialog class="lightbox" id="lightbox">
    <Image src={entry.data.photo} alt={alt} width={2000} loading="lazy" />
  </dialog>

  <script>
    const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
    document.querySelector("[data-open-lightbox]")?.addEventListener("click", () => dialog?.showModal());
    dialog?.addEventListener("click", () => dialog.close());
  </script>
</Base>
