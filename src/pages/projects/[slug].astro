---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects", (p) => !p.data.draft)).sort(
    (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { title, summary, description, sections, github, demo, stack, role, cover } = project.data;

// Turn bare URLs in plain-text captions into links.
const linkify = (text: string) =>
  text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener">$1</a>');

// Skip the cover in the gallery when it is also the first section image.
const firstSection = sections[0];
const coverRepeats = firstSection?.images[0]?.src === cover.src;
---
<Base title={`${title} — Albert Le`} description={summary ?? description} theme="portfolio">
  <main class="p-wrap proj">
    <header class="proj-head">
      <a class="back" href="/portfolio/">&larr; All projects</a>
      <h1>{title}</h1>
      {summary && <p class="lead">{summary}</p>}
      {(role || stack || demo || github) && (
        <dl class="facts">
          {role && <div><dt>Role</dt><dd>{role}</dd></div>}
          {stack && <div><dt>Stack</dt><dd>{stack.split(" · ").join(", ")}</dd></div>}
          {(demo || github) && (
            <div>
              <dt>Links</dt>
              <dd>
                {demo && <a href={demo} target="_blank" rel="noopener">Demo</a>}
                {demo && github && " · "}
                {github && <a href={github} target="_blank" rel="noopener">GitHub</a>}
              </dd>
            </div>
          )}
        </dl>
      )}
    </header>

    <Image class="hero" src={cover} alt={title} widths={[600, 1000, 1600, 2000]} sizes="(min-width: 1040px) 992px, 100vw" loading="eager" />

    {description && <div class="text"><p>{description}</p></div>}

    {sections.map((s, i) => {
      const images = i === 0 && coverRepeats ? s.images.slice(1) : s.images;
      return (
        <figure class="shots">
          {images.length > 0 && (
            <div class="imgs">
              {images.map((img) => (
                <Image src={img} alt="" widths={[500, 900, 1400]} sizes="(min-width: 1040px) 488px, (min-width: 640px) 50vw, 100vw" />
              ))}
            </div>
          )}
          {s.text && <figcaption class="text"><p set:html={linkify(s.text)} /></figcaption>}
        </figure>
      );
    })}

    <div class="text"><Content /></div>

    {(prev || next) && (
      <nav class="proj-nav" aria-label="More projects">
        {prev ? <a href={`/projects/${prev.id}/`}>&larr; {prev.data.title}</a> : <span />}
        {next && <a href={`/projects/${next.id}/`}>{next.data.title} &rarr;</a>}
      </nav>
    )}
  </main>
</Base>
